{
  "$id": "https://lithium-niobate.com/api/v1/schema/tensor.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A material tensor of point group 3m from one source: independent components with per-component provenance, the Voigt matrix with its convention, the full Cartesian tensor generated by code, the frame, and the symmetry form. voigt, full and symmetry_form are generated by the builder and always present in API output. The id is tensor/variant/source_id[-qualifier].",
  "properties": {
    "conditions": {
      "$ref": "common.schema.json#/$defs/conditions"
    },
    "consistency": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "type": "string"
          },
          "result": {
            "type": "string"
          },
          "status": {
            "const": "C"
          }
        },
        "required": [
          "check",
          "result"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "default": {
      "type": "boolean"
    },
    "dk_scale": {
      "description": "For nlo-d only: absolute scale ( pitfall 11).",
      "enum": [
        "legacy",
        "post-Shoji-1997"
      ]
    },
    "frame": {
      "$ref": "common.schema.json#/$defs/frame"
    },
    "full": {
      "type": "array"
    },
    "id": {
      "pattern": "^[a-z0-9][A-Za-z0-9.-]*/[a-z0-9.-]+/[a-z0-9.-]+$",
      "type": "string"
    },
    "independent": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "derivation": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "original_reference": {
            "type": "string"
          },
          "status": {
            "$ref": "common.schema.json#/$defs/propertyStatus"
          },
          "uncertainty": {
            "$ref": "common.schema.json#/$defs/uncertainty"
          },
          "value": {
            "type": "number"
          }
        },
        "required": [
          "value"
        ],
        "type": "object"
      },
      "minProperties": 1,
      "type": "object"
    },
    "kind": {
      "const": "tensor"
    },
    "name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "public": {
      "type": "boolean"
    },
    "rank": {
      "enum": [
        2,
        3,
        4
      ]
    },
    "scale": {
      "description": "Values are in unit (no extra scale applied) unless stated; always 1 in this dataset.",
      "type": "number"
    },
    "symbol": {
      "type": "string"
    },
    "symmetry_form": {
      "additionalProperties": false,
      "properties": {
        "form": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "array"
        },
        "mirror": {
          "type": "string"
        },
        "point_group": {
          "const": "3m"
        },
        "relations": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "tensor": {
      "enum": [
        "permittivity-T",
        "permittivity-S",
        "elastic-stiffness-cE",
        "elastic-compliance-sE",
        "piezo-stress-e",
        "piezo-strain-d",
        "eo-rT",
        "eo-rS",
        "photoelastic-p",
        "nlo-d"
      ]
    },
    "unit": {
      "$ref": "common.schema.json#/$defs/unit"
    },
    "variant": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "variant_note": {
      "type": "string"
    },
    "voigt": {
      "items": {
        "items": {
          "type": "number"
        },
        "type": "array"
      },
      "type": "array"
    },
    "voigt_convention": {
      "additionalProperties": false,
      "properties": {
        "full_from_voigt": {
          "type": "string"
        },
        "order": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shear_strain": {
          "enum": [
            "engineering",
            "tensor"
          ]
        }
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "kind",
    "tensor",
    "name",
    "symbol",
    "rank",
    "unit",
    "variant",
    "frame",
    "independent",
    "provenance"
  ],
  "title": "Tensor property record",
  "type": "object"
}
