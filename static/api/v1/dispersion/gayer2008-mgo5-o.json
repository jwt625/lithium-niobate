  "python": "def n(L_um, T_C=24.5):\n    a1, a2, a3, a4, a5, a6 = 5.653, 0.1185, 0.2091, 89.61, 10.85, 0.0197\n    b1, b2, b3, b4 = 7.941e-07, 3.134e-08, -4.641e-09, -2.188e-06\n    f = (T_C - 24.5) * (T_C + 570.82); L2 = L_um * L_um\n    return (a1 + b1 * f + (a2 + b2 * f) / (L2 - (a3 + b3 * f) ** 2) + (a4 + b4 * f) / (L2 - a5 ** 2) - a6 * L2) ** 0.5\n"
