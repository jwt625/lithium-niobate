{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithium-niobate.com/api/v1/schema/dispersion.schema.json",
  "title": "Dispersion model",
  "description": "Sellmeier-type refractive-index model for one variant and one axis: named formula, coefficients, validity, reference temperature, errata, and check values that the builder reproduces.",
  "type": "object",
  "required": ["id", "name", "variant", "axis", "formula", "coefficients", "lambda_unit", "valid_lambda_um", "reference_T_C", "provenance", "check_values"],
  "additionalProperties": false,
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/id"},
    "name": {"type": "string"},
    "variant": {"$ref": "common.schema.json#/$defs/id"},
    "axis": {"enum": ["o", "e"]},
    "formula": {
      "type": "object",
      "required": ["form", "latex", "expression"],
      "additionalProperties": false,
      "properties": {
        "form": {"enum": ["sellmeier-3term", "gayer-2008"]},
        "latex": {"type": "string"},
        "expression": {"type": "string", "description": "Plain-text formula with the variable names used in coefficients."},
        "rii_formula": {"type": "integer", "description": "refractiveindex.info formula number, when one exists."}
      }
    },
    "coefficients": {"type": "object", "additionalProperties": {"type": "number"}},
    "coefficient_units": {"type": "object", "additionalProperties": {"type": "string"}},
    "lambda_unit": {"const": "um"},
    "valid_lambda_um": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "valid_T_C": {"type": ["array", "null"], "items": {"type": "number"}},
    "temperature_dependent": {"type": "boolean"},
    "reference_T_C": {"type": "number"},
    "errata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["citation", "effect", "applied"],
        "additionalProperties": false,
        "properties": {
          "citation": {"type": "string"},
          "doi": {"$ref": "common.schema.json#/$defs/doi"},
          "issued": {"$ref": "common.schema.json#/$defs/isoDate"},
          "effect": {"type": "string"},
          "applied": {"type": "boolean"}
        }
      }
    },
    "check_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lambda_nm", "T_C", "n", "tolerance", "source"],
        "additionalProperties": false,
        "properties": {
          "lambda_nm": {"type": "number"},
          "T_C": {"type": "number"},
          "n": {"type": "number"},
          "tolerance": {"type": "number"},
          "source": {"type": "string"}
        }
      }
    },
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "caveats": {"type": "array", "items": {"type": "string"}},
    "default": {"type": "boolean"},
    "notes": {"type": "string"},
    "public": {"type": "boolean"}
  }
}
