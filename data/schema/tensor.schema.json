{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lithium-niobate.com/api/v1/schema/tensor.schema.json",
  "title": "Tensor property record",
  "description": "A material tensor of point group 3m from one source: independent components with per-component provenance, the Voigt matrix with its convention, the full Cartesian tensor generated by code, the frame, and the symmetry form. voigt, full and symmetry_form are generated by the builder and always present in API output. The id is tensor/variant/source_id[-qualifier].",
  "type": "object",
  "required": ["id", "kind", "tensor", "name", "symbol", "rank", "unit", "variant", "frame", "independent", "provenance"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][A-Za-z0-9.-]*/[a-z0-9.-]+/[a-z0-9.-]+$"},
    "kind": {"const": "tensor"},
    "tensor": {"enum": ["permittivity-T", "permittivity-S", "elastic-stiffness-cE", "elastic-compliance-sE", "piezo-stress-e", "piezo-strain-d", "eo-rT", "eo-rS", "photoelastic-p", "nlo-d"]},
    "name": {"type": "string"},
    "symbol": {"type": "string"},
    "rank": {"enum": [2, 3, 4]},
    "unit": {"$ref": "common.schema.json#/$defs/unit"},
    "scale": {"type": "number", "description": "Values are in unit (no extra scale applied) unless stated; always 1 in this dataset."},
    "variant": {"$ref": "common.schema.json#/$defs/id"},
    "variant_note": {"type": "string"},
    "conditions": {"$ref": "common.schema.json#/$defs/conditions"},
    "frame": {"$ref": "common.schema.json#/$defs/frame"},
    "independent": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "additionalProperties": false,
        "properties": {
          "value": {"type": "number"},
          "uncertainty": {"$ref": "common.schema.json#/$defs/uncertainty"},
          "status": {"$ref": "common.schema.json#/$defs/propertyStatus"},
          "original_reference": {"type": "string"},
          "locator": {"type": "string"},
          "derivation": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    },
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "default": {"type": "boolean"},
    "dk_scale": {"enum": ["legacy", "post-Shoji-1997"], "description": "For nlo-d only: absolute scale (R06 pitfall 11)."},
    "voigt_convention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {"type": "array", "items": {"type": "string"}},
        "shear_strain": {"enum": ["engineering", "tensor"]},
        "full_from_voigt": {"type": "string"}
      }
    },
    "voigt": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "full": {"type": "array"},
    "symmetry_form": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "point_group": {"const": "3m"},
        "mirror": {"type": "string"},
        "relations": {"type": "array", "items": {"type": "string"}},
        "form": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "consistency": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "result"],
        "additionalProperties": false,
        "properties": {
          "check": {"type": "string"},
          "result": {"type": "string"},
          "status": {"const": "C"}
        }
      }
    },
    "notes": {"type": "string"},
    "public": {"type": "boolean"}
  }
}
