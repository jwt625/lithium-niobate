{
  "name": "lithium-niobate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 47614 --strictPort",
    "build": "vite build && pagefind --site build",
    "preview": "vite preview --host 127.0.0.1 --port 47615 --strictPort",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:e2e": "playwright test",
    "test:physics": "node --test src/lib/physics/"
  },
  "dependencies": {
    "three": "0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/node": "24.19.2",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.169.0",
    "mdsvex": "0.12.8",
    "pagefind": "1.3.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
